
@page "/"
@using System.Net.Http.Json
@using SearchDemonSlayerAPI.Models
@inject HttpClient Http

<PageTitle>Demon Slayer</PageTitle>

<h1>Personagens de Demon Slayer</h1>

<p>Pesquise ou explore os personagens do anime.</p>

<div class="mb-3">
    <input class="form-control"
           placeholder="Nome do personagem"
           @bind="pesquisa" />

    <button class="btn btn-primary mt-2"
            @onclick="Pesquisar">
        Pesquisar
    </button>

    <button class="btn btn-secondary mt-2"
            @onclick="Listar">
        Listar todos
    </button>
</div>

@if (carregando)
{
    <p>Carregando personagens...</p>
}
else if (erro != "")
{
    <p class="text-danger">@erro</p>
}
else
{
    <div class="row">
        @foreach (var personagem in personagens)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <img src="@personagem.Img"
                         class="card-img-top"
                         alt="@personagem.Name"
                         style="height:280px;object-fit:contain" />

                    <div class="card-body">
                        <h5>@personagem.Name</h5>
                        <p>Idade: @(personagem.Age?.ToString() ?? "Não informada")</p>
                        <p>Raça: @personagem.Race</p>
                        <p>Frase: @personagem.Quote</p>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!modoPesquisa)
    {
        <button class="btn btn-outline-primary"
                disabled="@(pagina == 1)"
                @onclick="Anterior">
            Anterior
        </button>

        <span class="mx-2">Página @pagina de @totalPaginas</span>

        <button class="btn btn-outline-primary"
                disabled="@(pagina >= totalPaginas)"
                @onclick="Proxima">
            Próxima
        </button>
    }
}

@code {
    private List<Personagem> personagens = new();
    private string pesquisa = "";
    private string erro = "";
    private bool carregando = false;
    private bool modoPesquisa = false;
    private int pagina = 1;
    private int totalPaginas = 1;

    protected override async Task OnInitializedAsync()
    {
        await Listar();
    }

    private async Task Listar()
    {
        modoPesquisa = false;
        carregando = true;
        erro = "";

        try
        {
            var url = $"https://www.demonslayer-api.com/api/v1/characters?page={pagina}";

            var resposta = await Http.GetFromJsonAsync<RespostaApi>(url);

            personagens = resposta?.Content ?? new();
            totalPaginas = resposta?.Pagination.TotalPages ?? 1;

            await CarregarFrases();
        }
        catch (Exception)
        {
            erro = "Não foi possível carregar os personagens.";
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task CarregarFrases()
    {
        foreach (var personagem in personagens)
        {
            if (!string.IsNullOrEmpty(personagem.Quote))
                continue;

            try
            {
                var url = $"https://www.demonslayer-api.com/api/v1/characters?id={personagem.Id}";
                var detalhe = await Http.GetFromJsonAsync<Personagem>(url);

                if (detalhe != null)
                    personagem.Quote = detalhe.Quote;
            }
            catch (Exception)
            {
                personagem.Quote = "Frase não disponível";
            }
        }
    }

    private async Task Pesquisar()
    {
        if (string.IsNullOrWhiteSpace(pesquisa))
        {
            pagina = 1;
            await Listar();
            return;
        }

        carregando = true;
        modoPesquisa = true;
        erro = "";

        try
        {
            var nome = Uri.EscapeDataString(pesquisa.Trim());
            var url = $"https://www.demonslayer-api.com/api/v1/characters?name={nome}";

            var resultado = await Http.GetFromJsonAsync<Personagem>(url);

            personagens = resultado != null
                ? new List<Personagem> { resultado }
                : new List<Personagem>();
        }
        catch (Exception)
        {
            personagens.Clear();
            erro = "Personagem não encontrado ou erro na API.";
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task Proxima()
    {
        if (pagina < totalPaginas)
        {
            pagina++;
            await Listar();
        }
    }

    private async Task Anterior()
    {
        if (pagina > 1)
        {
            pagina--;
            await Listar();
        }
    }
}
